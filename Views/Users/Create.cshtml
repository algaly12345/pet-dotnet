@model pets.ViewModels.UserCreateVm
@{
    ViewData["Title"] = "Create User";
    var roles = (List<string>)(ViewBag.Roles ?? new List<string>());
}

<div class="dashboard-content p-4" style="max-width:700px;">
    <h3 class="mb-3">إضافة مستخدم</h3>

    <div asp-validation-summary="All" class="alert alert-danger"></div>

    <form method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Username</label>
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">FullName</label>
            <input asp-for="FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Role</label>
            <select asp-for="RoleName" class="form-select">
                <option value="">-- اختر الدور --</option>
                @foreach (var r in roles)
                {
                    <option value="@r">@r</option>
                }
            </select>
            <span asp-validation-for="RoleName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label class="form-check-label">Active</label>
        </div>

        <button class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
