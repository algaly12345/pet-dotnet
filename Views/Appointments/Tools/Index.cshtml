@model List<pets.Models.ToolItem>
@{
    ViewData["Title"] = "الأدوات";
}

<div class="dashboard-content">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0">الأدوات</h3>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> إضافة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead>
                <tr>
                    <th>#</th>
                    <th>الاسم</th>
                    <th>ملاحظات</th>
                    <th style="width:220px;">إجراءات</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var x in Model)
                {
                    <tr>
                        <td>@x.Id</td>
                        <td>@x.Name</td>
                        <td>@x.Notes</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@x.Id" class="btn btn-sm btn-warning">
                                تعديل
                            </a>
                            <a asp-action="Delete" asp-route-id="@x.Id" class="btn btn-sm btn-danger">
                                حذف
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="text-muted">لا توجد بيانات.</div>
            }
        </div>
    </div>
</div>
