@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - pets</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <style>
        body {
            direction: @(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr");
            text-align: @(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "right" : "left");
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content-wrapper {
            flex: 1;
            display: flex;
        }

        .sidebar {
            width: 250px;
            background-color: #f8f9fa;
            min-height: calc(100vh - 56px);
            padding: 20px;
            border- @(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "left" : "right") : 1px solid #dee2e6;
        }

        .main-content {
            flex: 1;
            padding: 20px;
        }

        .footer {
            background-color: #f8f9fa;
            padding: 15px 0;
            border-top: 1px solid #dee2e6;
            margin-top: auto;
        }

        .nav-link {
            color: #495057;
        }

            .nav-link:hover {
                color: #0d6efd;
            }

        .sidebar-link {
            display: block;
            padding: 10px 15px;
            color: #495057;
            text-decoration: none;
            border-radius: 4px;
            margin-bottom: 5px;
        }

            .sidebar-link:hover {
                background-color: #e9ecef;
                color: #0d6efd;
            }

            .sidebar-link.active {
                background-color: #0d6efd;
                color: white;
            }

        .dropdown-menu {
            text-align: @(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "right" : "left");
        }

        .navbar-nav {
            flex-direction: @(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "row-reverse" : "row");
        }

        .navbar-toggler {
            order: @(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "1" : "0");
        }

        .language-switcher {
            display: flex;
            gap: 5px;
        }

        .language-btn {
            padding: 5px 10px;
            border-radius: 4px;
            border: 1px solid #dee2e6;
            background-color: #f8f9fa;
            cursor: pointer;
        }

            .language-btn.active {
                background-color: #0d6efd;
                color: white;
                border-color: #0d6efd;
            }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="bi bi-house-door-fill"></i> pets
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="@Url.Action("Index", "Home")">@Localizer["Home"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Privacy", "Home")">@Localizer["Privacy"]</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-globe"></i> @Localizer["Language"]
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="languageDropdown">
                            <li>
                                <a class="dropdown-item" href="@Url.Action("SetLanguage", "Home", new { culture = "en", returnUrl = Context.Request.Path })">
                                    @Localizer["English"]
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="@Url.Action("SetLanguage", "Home", new { culture = "ar", returnUrl = Context.Request.Path })">
                                    @Localizer["Arabic"]
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Content Wrapper -->
    <div class="content-wrapper">
        <!-- Sidebar -->
        <div class="sidebar">
            <h5 class="mb-3">@Localizer["Home"]</h5>
            <a href="@Url.Action("Index", "Home")" class="sidebar-link active">
                <i class="bi bi-house-door"></i> @Localizer["Home"]
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-list-ul"></i> @Localizer["Products"]
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-people"></i> @Localizer["Customers"]
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-graph-up"></i> @Localizer["Reports"]
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-gear"></i> @Localizer["Settings"]
            </a>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer mt-auto">
        <div class="container text-center">
            <p class="mb-0">&copy; 2024 pets. @Localizer["AllRightsReserved"]</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>