@model pets.ViewModels.LoginVm

@{
    Layout = null; // ✅ مهم عشان ما يدخل لياوت الداشبورد
    ViewData["Title"] = "Login";
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<!DOCTYPE html>
<html lang="@(isRtl ? "ar" : "en")" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <title>VetCare | Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap@(isRtl ? ".rtl" : "").min.css" rel="stylesheet" />
    <!-- Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #0891b2, #0e7490);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .login-card {
            background: #fff;
            border-radius: 18px;
            width: 100%;
            max-width: 420px;
            padding: 35px;
            box-shadow: 0 20px 40px rgba(0,0,0,.2);
        }

        .login-logo {
            width: 70px;
            height: 70px;
            border-radius: 16px;
            background: #0891b2;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            margin: 0 auto 15px;
        }

        .login-title {
            text-align: center;
            font-weight: 800;
            margin-bottom: 18px;
            color: #0f172a;
        }

        .form-control {
            border-radius: 12px;
            padding: 12px;
        }

        .btn-login {
            background: #0891b2;
            color: #fff;
            border-radius: 12px;
            padding: 12px;
            font-weight: 700;
            width: 100%;
        }

        .btn-login:hover {
            background: #0e7490;
            color: #fff;
        }

        .language-switch {
            text-align: center;
            margin-top: 16px;
        }

        .language-switch a {
            text-decoration: none;
            font-weight: 700;
        }
    </style>
</head>
<body>

<div class="login-card">
    <div class="login-logo">
        <i class="bi bi-heart-pulse-fill"></i>
    </div>

    <h4 class="login-title">
        @(isRtl ? "تسجيل الدخول" : "Login")
    </h4>

    @* ✅ Success message *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Success"]
        </div>
    }

    @* ✅ Show server-side errors (ModelState.AddModelError("", "...")) *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    <form asp-action="Index" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">@(isRtl ? "اسم المستخدم" : "Username")</label>
            <input asp-for="UserName" class="form-control" autocomplete="username" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">@(isRtl ? "كلمة المرور" : "Password")</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="RememberMe" class="form-check-input" />
            <label class="form-check-label">@(isRtl ? "تذكرني" : "Remember me")</label>
        </div>

        <button type="submit" class="btn btn-login">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            @(isRtl ? "دخول" : "Sign In")
        </button>
    </form>

 <div class="language-switch">
    <a asp-controller="Home"
       asp-action="SetLanguage"
       asp-route-culture="ar"
       asp-route-returnUrl="@Context.Request.Path">
        العربية
    </a>
    |
    <a asp-controller="Home"
       asp-action="SetLanguage"
       asp-route-culture="en"
       asp-route-returnUrl="@Context.Request.Path">
        English
    </a>
</div>

</div>

<!-- Optional: client-side validation (if you want Required to show without post) -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>
