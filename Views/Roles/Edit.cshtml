@model pets.ViewModels.RoleFormVm
@using System.Globalization

@{
    ViewData["Title"] = "Edit Role";
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="dashboard-content">
    <h3 class="mb-3">@((isRtl) ? "تعديل الدور" : "Edit Role")</h3>

    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">@((isRtl) ? "اسم الدور" : "Role Name")</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <label class="form-label">@((isRtl) ? "الصلاحيات" : "Permissions")</label>

                <div class="border rounded p-3" style="max-height: 340px; overflow:auto;">
                    @foreach (var p in Model.AllPermissions)
                    {
                        <div class="form-check mb-2">
                            <input class="form-check-input"
                                   type="checkbox"
                                   name="SelectedPermissions"
                                   value="@p.Value"
                                   @(p.Selected ? "checked" : "") />
                            <label class="form-check-label">
                                <div class="fw-bold">@p.Display</div>
                                <small class="text-muted">@p.Value</small>
                            </label>
                        </div>
                    }
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-save"></i> @((isRtl) ? "تحديث" : "Update")
                    </button>
                    <a class="btn btn-secondary" asp-action="Index">
                        @((isRtl) ? "رجوع" : "Back")
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>
