@model List<Microsoft.AspNetCore.Identity.IdentityRole>
@using System.Globalization

@{
    ViewData["Title"] = "Roles";
    var isRtl = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="dashboard-content">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0">@((isRtl) ? "الأدوار" : "Roles")</h3>
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg"></i>
            @((isRtl) ? "إنشاء دور" : "Create Role")
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead>
                <tr>
                    <th>@((isRtl) ? "الاسم" : "Name")</th>
                    <th style="width:200px;"></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Name</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@r.Id">
                                <i class="bi bi-pencil"></i> @((isRtl) ? "تعديل" : "Edit")
                            </a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@r.Id">
                                <i class="bi bi-trash"></i> @((isRtl) ? "حذف" : "Delete")
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
