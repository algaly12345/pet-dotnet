@model pets.ViewModels.RoleFormVm
@{
    ViewData["Title"] = "Create Role";
    var isRtl = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ar";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0">@((isRtl) ? "إضافة دور" : "Create Role")</h3>
        <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> @((isRtl) ? "رجوع" : "Back")
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <form asp-controller="Roles" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label fw-bold">@((isRtl) ? "اسم الدور" : "Role Name")</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <hr class="my-4" />

                <h5 class="mb-2">@((isRtl) ? "الصلاحيات" : "Permissions")</h5>

                <div class="border rounded p-3" style="max-height: 340px; overflow:auto;">
                    @if (Model.AllPermissions == null || Model.AllPermissions.Count == 0)
                    {
                        <div class="text-muted">@((isRtl) ? "لا توجد صلاحيات." : "No permissions.")</div>
                    }
                    else
                    {
                        @foreach (var p in Model.AllPermissions)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedPermissions"
                                       value="@p.Value" />
                                <label class="form-check-label">
                                    @p.Display
                                    <small class="text-muted d-block">@p.Value</small>
                                </label>
                            </div>
                        }
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Roles" asp-action="Index" class="btn btn-light">
                        @((isRtl) ? "إلغاء" : "Cancel")
                    </a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> @((isRtl) ? "إضافة" : "Create")
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
