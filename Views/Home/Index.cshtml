@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["HomePage"];
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h1 class="display-4 text-center my-5">@Localizer["Welcome"]</h1>
            <p class="lead text-center">@Localizer["LearnAbout"]</p>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-people-fill text-primary" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-2">@Localizer["CustomersCount"]</h5>
                    <p class="card-text">1,234</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-box-seam text-success" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-2">@Localizer["ProductsCount"]</h5>
                    <p class="card-text">567</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-cart-fill text-warning" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-2">@Localizer["OrdersCount"]</h5>
                    <p class="card-text">89</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <i class="bi bi-graph-up text-danger" style="font-size: 2rem;"></i>
                    <h5 class="card-title mt-2">@Localizer["Revenue"]</h5>
                    <p class="card-text">$12,345</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">@Localizer["LatestEvents"]</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@Localizer["NewProductAdded"]</h6>
                                <small>قبل 2 دقائق</small>
                            </div>
                            <p class="mb-1">@Localizer["ProductAddedDescription"]</p>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@Localizer["SaleCompleted"]</h6>
                                <small>قبل ساعة</small>
                            </div>
                            <p class="mb-1">@Localizer["SaleDescription"]</p>
                        </a>
                        <a href="#" class="list-group-item list-group-item-action">
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">@Localizer["CustomerUpdated"]</h6>
                                <small>قبل 3 ساعات</small>
                            </div>
                            <p class="mb-1">@Localizer["CustomerUpdateDescription"]</p>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>