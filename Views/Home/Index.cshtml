@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = "VetCare Clinic - Dashboard";
}

<!-- هذا هو محتوى الصفحة الرئيسية -->
<div class="container mt-4">
    <h1 class="text-center">@Localizer["WelcomeToDashboard"]</h1>
    <p class="text-center">@Localizer["DashboardDescription"]</p>
    
    <!-- يمكنك إضافة أي محتوى آخر هنا -->
    <div class="row mt-5">
        <div class="col-md-12 text-center">
            <div class="alert alert-info">
                <i class="bi bi-info-circle-fill"></i> @Localizer["WelcomeMessage"]
            </div>
        </div>
    </div>
</div>